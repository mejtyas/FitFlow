{
  "name": "fitflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "knip": "knip --no-exit-code",
    "find-duplicates": "jscpd app/ components/ --min-lines 10 --min-tokens 50 --format typescript,tsx --reporters console --threshold 0 --ignore '**/*.test.*,**/*.spec.*,**/node_modules/**'",
    "quality-gate": "npx tsc --noEmit && npm run lint && npm run knip && npm run find-duplicates"
  },
  "dependencies": {
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.98.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "16.2.4",
    "exceljs": "^4.4.0",
    "papaparse": "^5.5.3",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^2.15.0",
    "tailwind-merge": "^3.5.0"
  },
  "overrides": {
    "@emnapi/core": "1.10.0",
    "@emnapi/runtime": "1.10.0"
  },
  "devDependencies": {
    "postcss": "^8.5.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jscpd": "^4.0.5",
    "knip": "^5.72.0",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
